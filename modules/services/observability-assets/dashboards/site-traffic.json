    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Firewall drops when an isolated VLAN device (IoT or Guest) tried to connect to port 443 on the router or NAS.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 48
      },
      "id": 16,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"kernel\"} |~ \"nft6?-drop-(input|forward):\" |~ `IN=(br-iot|br-guest)\\b` |~ `DPT=443\\b` [$__range])) or vector(0)",
          "instant": true,
