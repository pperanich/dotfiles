  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              }
            ]
          },
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "up{job=\"node\",instance=\"pp-router1\"}",
          "legendFormat": "router",
          "refId": "A"
        }
      ],
      "title": "Router Up",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{job=\"node\",instance=\"pp-router1\",mode=\"idle\"}[5m]))",
          "legendFormat": "cpu busy",
          "refId": "A"
        }
      ],
      "title": "CPU Busy",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "1 - (node_memory_MemAvailable_bytes{job=\"node\",instance=\"pp-router1\"} / node_memory_MemTotal_bytes{job=\"node\",instance=\"pp-router1\"})",
          "legendFormat": "memory used",
          "refId": "A"
        }
      ],
      "title": "Memory Used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "1 - (node_filesystem_avail_bytes{job=\"node\",instance=\"pp-router1\",mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{job=\"node\",instance=\"pp-router1\",mountpoint=\"/\",fstype!=\"tmpfs\"})",
          "legendFormat": "rootfs used",
          "refId": "A"
        }
      ],
      "title": "Disk Used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{job=\"node\",instance=\"pp-router1\",device=~\"enp.*|br-main|pp-wg\"}[5m]))",
          "legendFormat": "{{device}} rx",
          "refId": "A"
        },
        {
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{job=\"node\",instance=\"pp-router1\",device=~\"enp.*|br-main|pp-wg\"}[5m]))",
          "legendFormat": "{{device}} tx",
          "refId": "B"
        }
      ],
      "title": "Interface Throughput",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_drop_total{job=\"node\",instance=\"pp-router1\",device=~\"enp.*|br-main|pp-wg\"}[5m]))",
          "legendFormat": "{{device}} rx drops",
          "refId": "A"
        },
        {
          "expr": "sum by (device) (rate(node_network_transmit_drop_total{job=\"node\",instance=\"pp-router1\",device=~\"enp.*|br-main|pp-wg\"}[5m]))",
          "legendFormat": "{{device}} tx drops",
          "refId": "B"
        }
      ],
      "description": "br-main rx drops at a low steady rate are benign: UniFi 802.11r FT-over-DS frames (ethertype 0x890d) the bridge cannot parse. Investigate only sustained rate changes or drops on other interfaces.",
      "title": "Interface Drops",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 7,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "node_nf_conntrack_entries{instance=\"pp-router1\"} / node_nf_conntrack_entries_limit{instance=\"pp-router1\"}",
          "legendFormat": "conntrack used",
          "refId": "A"
        }
      ],
      "title": "Conntrack Usage",
      "type": "timeseries"
    }
