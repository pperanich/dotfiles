        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (host) (rate(caddy_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Requests By Host",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal",
