/.claude/

# Only the managed parts of home/.claude are tracked; the rest is runtime state.
/home/.claude/*
!/home/.claude/CLAUDE.md
!/home/.claude/commands/

# Pi local goal/runtime state
/.pi/goals/
/.pi/.goals-pool-snapshot.json

/home/Library/Developer/

# Codex writes runtime state into ~/.codex; only AGENTS.md is managed here.
/home/.codex/*
!/home/.codex/AGENTS.md

# OpenCode writes runtime state into ~/.config/opencode; AGENTS.md is managed here.
home/.config/opencode/*
!home/.config/opencode/AGENTS.md
.lavish/

hm-nix-direnv.sh
