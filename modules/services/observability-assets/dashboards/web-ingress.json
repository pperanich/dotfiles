  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(caddy_http_request_duration_seconds_count, instance)",
        "includeAll": true,
        "label": "Host",
        "multi": true,
        "name": "instance",
        "query": {
          "qryType": 1,
          "query": "label_values(caddy_http_request_duration_seconds_count, instance)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Web Ingress",
  "uid": "web_ingress",
  "version": 2,
  "weekStart": "",
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (instance, host) (rate(caddy_http_request_duration_seconds_count{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{host}} ({{instance}})",
          "refId": "A"
        }
      ],
      "title": "Requests By Host",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqps",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (instance, class) (label_replace(rate(caddy_http_request_duration_seconds_count{instance=~\"$instance\"}[5m]), \"class\", \"${1}xx\", \"code\", \"([0-9]).*\"))",
          "legendFormat": "{{class}} ({{instance}})",
          "refId": "A"
        }
      ],
      "title": "Responses By Status Class",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "(sum by (instance, host) (rate(caddy_http_request_duration_seconds_count{instance=~\"$instance\", code=~\"5..\"}[15m])) or 0 * sum by (instance, host) (rate(caddy_http_request_duration_seconds_count{instance=~\"$instance\"}[15m]))) / sum by (instance, host) (rate(caddy_http_request_duration_seconds_count{instance=~\"$instance\"}[15m]))",
          "legendFormat": "{{host}} ({{instance}})",
          "refId": "A"
        }
      ],
      "title": "5xx Ratio By Host",
      "type": "timeseries",
      "description": "Share of each site's responses that were server errors, mostly 502s when the upstream service is down or restarting."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (instance, host, le) (rate(caddy_http_request_duration_seconds_bucket{instance=~\"$instance\", code!=\"101\"}[15m])))",
          "legendFormat": "{{host}} ({{instance}})",
          "refId": "A"
        }
      ],
      "title": "p95 Latency By Host",
      "type": "timeseries",
      "description": "95th-percentile time to response, WebSocket upgrades (101) excluded because they stay open."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "sum by (instance, server) (caddy_http_requests_in_flight{instance=~\"$instance\"})",
          "legendFormat": "{{instance}} {{server}}",
          "refId": "A"
        }
      ],
      "title": "Requests In Flight",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "Bps",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 20
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (instance, host) (rate(caddy_http_response_size_bytes_sum{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{host}} ({{instance}})",
          "refId": "A"
