#!/usr/bin/env bash
set -euo pipefail

scratch=$(mktemp -d "${TMPDIR:-/tmp}/rex-project-picker.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

list_projects() {
  # Emits NAME<TAB>PATH, NUL-terminated and sorted by NAME, where NAME defaults
  # to PATH. Needs bash 4 for the associative array; the picker always invokes
  # this script through the Nix bash it resolves from the profile.
  local root depth marker path name_key project
  declare -A names=()
  (($# > 0)) || {
    echo 'Expected ROOT DEPTH pairs, --project PATH, or --name PATH NAME' >&2
    return 2
  }
  : >|"$scratch/projects"
  while (($#)); do
    if [[ $1 == --project ]]; then
      (($# >= 2)) || {
        echo 'Expected --project PATH' >&2
        return 2
      }
      [[ $2 == /* ]] || {
        echo "Project path must be absolute: $2" >&2
        return 2
      }
      # A declared project is listed as itself, without a marker or a walk.
      if [[ -d $2 ]]; then
        project=$(cd -- "$2" && pwd -P) || project=$2
        printf '%s\0' "$project" >>"$scratch/projects"
      fi
      shift 2
      continue
    fi
    if [[ $1 == --name ]]; then
      (($# >= 3)) || {
        echo 'Expected --name PATH NAME' >&2
        return 2
      }
      [[ $2 == /* ]] || {
        echo "Name path must be absolute: $2" >&2
        return 2
      }
      [[ -n $3 ]] || {
        echo "Name must not be empty: $2" >&2
        return 2
      }
      # Key by the canonical path so a name survives a symlinked root, and fall
      # back to the literal path when the directory cannot be resolved.
  name_key=$2
      if [[ -d $2 ]]; then
        name_key=$(cd -- "$2" && pwd -P) || name_key=$2
      fi
      names[$name_key]=$3
      shift 3
      continue
    fi
    (($# >= 2)) || {
      echo 'Expected ROOT DEPTH pairs' >&2
      return 2
    }
    root=$1 depth=$2
    shift 2
    if [[ ! $depth =~ ^[0-9]+$ || ${#depth} -gt 2 ]] || ((10#$depth > 32)); then
      echo "Invalid project depth: $depth (expected 0..32)" >&2
      return 2
    fi
    [[ -e $root ]] || continue
    root=$(cd -- "$root" && pwd -P) || return
    "${PROJECT_PICKER_FD:-fd}" --hidden --no-ignore --case-sensitive \
      --absolute-path --type directory --type file --prune --print0 \
      --max-depth "$((10#$depth + 1))" '^\.git$' "$root" >|"$scratch/markers" || return
    while IFS= read -r -d '' marker; do
      marker=${marker%/}
      printf '%s\0' "${marker%/.git}" >>"$scratch/projects"
    done <"$scratch/markers"
  done
  while IFS= read -r -d '' path; do
    printf '%s\t%s\0' "${names[$path]:-$path}" "$path"
  done <"$scratch/projects" | LC_ALL=C sort -zu
}

case ${1:-} in
list)
  shift
  list_projects "$@"
  ;;
*)
  echo "Usage: $0 list [ROOT DEPTH | --project PATH | --name PATH NAME]..." >&2
  exit 2
  ;;
esac
