#!/usr/bin/env bash
set -euo pipefail

scratch=$(mktemp -d "${TMPDIR:-/tmp}/rex-project-picker.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

list_projects() {
  local root depth marker
  (($# > 0 && $# % 2 == 0)) || {
    echo 'Expected ROOT DEPTH pairs' >&2
    return 2
  }
  : >|"$scratch/projects"
  while (($#)); do
    root=$1 depth=$2
    shift 2
    if [[ ! $depth =~ ^[0-9]+$ || ${#depth} -gt 2 ]] || ((10#$depth > 32)); then
      echo "Invalid project depth: $depth (expected 0..32)" >&2
      return 2
    fi
    [[ -e $root ]] || continue
    root=$(cd -- "$root" && pwd -P) || return
    "${PROJECT_PICKER_FD:-fd}" --hidden --no-ignore --case-sensitive \
      --absolute-path --type directory --type file --prune --print0 \
      --max-depth "$((10#$depth + 1))" '^\.git$' "$root" >|"$scratch/markers" || return
    while IFS= read -r -d '' marker; do
      marker=${marker%/}
      printf '%s\0' "${marker%/.git}" >>"$scratch/projects"
    done <"$scratch/markers"
  done
  LC_ALL=C sort -zu "$scratch/projects"
}

pick() {
  local rex_cli=$1 fzf_cli=$2 fd_cli=$3 client=$4 server=$5 selected status producer producer_status=0
  shift 5
  export PROJECT_PICKER_FD=$fd_cli
  # A GUI-launched server may have a minimal PATH. These are stable profile paths.
  export PATH="${rex_cli%/*}:${fzf_cli%/*}:${fd_cli%/*}:$PATH"
  # Stream discovery into fzf so the popup paints before the walk finishes. The
  # tee'd copy tells a cancelled pick apart from a root with no projects.
  mkfifo "$scratch/stream"
  list_projects "$@" | tee "$scratch/list" >|"$scratch/stream" &
  producer=$!
  if FZF_DEFAULT_OPTS='' FZF_DEFAULT_OPTS_FILE='' "$fzf_cli" \
    --read0 --print0 --sync --no-multi --scheme=path --layout=reverse --border=none \
    --prompt='Project > ' --header='Enter: open project   Esc: cancel' \
    --color='fg:#cdd6f4,bg:#1e1e2e,hl:#cba6f7,fg+:#cdd6f4,bg+:#313244,hl+:#a6e3a1,prompt:#cba6f7,pointer:#a6e3a1' \
    --bind='ctrl-n:down,ctrl-p:up' <"$scratch/stream" >|"$scratch/selected"; then
    status=0
  else
    status=$?
  fi
  # A cancelled pick closes the stream early, so the producer dies of SIGPIPE.
  wait "$producer" || producer_status=$?
  case $status in
  0)
    IFS= read -r -d '' selected <"$scratch/selected" || return
    ;;
  1 | 130)
    # A reader that goes away early kills the producer with SIGPIPE: that is a cancel.
    if ((producer_status == 141)); then
      return 0
    fi
    if ((producer_status != 0)); then
      return "$producer_status"
    fi
    if [[ -s $scratch/list ]]; then
      return 0
    fi
    echo 'No projects found under the configured roots.' >&2
    return 1
    ;;
  *) return "$status" ;;
  esac
  local rex_args=(--autostart=false --color=never -C "$client")
  [[ -z $server ]] || rex_args+=(-S "$server")
  "$rex_cli" "${rex_args[@]}" 'do' rex_project_picker_open \
    --session "${REX_SESSION:?Missing Rex popup session}" \
    --block "${REX_BLOCK:?Missing Rex popup block}" "path=$selected"
}

case ${1:-popup} in
list)
  shift
  list_projects "$@"
  ;;
pick)
  shift
  if pick "$@"; then exit 0; else status=$?; fi
  printf '\nProject picker failed (%s). Press Enter to close.\n' "$status" >&2
  read -r _ || true
  exit "$status"
  ;;
popup)
  (($# == 0)) || shift
  rex_cli=$(command -v rex)
  rex_args=(--autostart=false --color=never)
  [[ -z ${REX_SERVER:-} ]] || rex_args+=(-S "$REX_SERVER")
  [[ -z ${2:-${REX_CLIENT:-}} ]] || rex_args+=(-C "${2:-$REX_CLIENT}")
  session=${1:-${REX_SESSION:-}}
  [[ -n $session ]] || {
    echo "Usage: $0 popup SESSION [APP_CLIENT]" >&2
    exit 2
  }
  "$rex_cli" "${rex_args[@]}" 'do' rex_project_picker --session "$session"
  ;;
*)
  echo "Usage: $0 [popup SESSION [APP_CLIENT] | list [ROOT DEPTH ...]]" >&2
  exit 2
  ;;
esac
