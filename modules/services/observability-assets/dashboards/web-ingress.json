      },
      "targets": [
        {
          "expr": "sum by (class) (label_replace(rate(caddy_http_request_duration_seconds_count[5m]), \"class\", \"${1}xx\", \"code\", \"([0-9]).*\"))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ],
      "title": "Responses By Status Class",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "expr": "(sum by (host) (rate(caddy_http_request_duration_seconds_count{code=~\"5..\"}[15m])) or 0 * sum by (host) (rate(caddy_http_request_duration_seconds_count[15m]))) / sum by (host) (rate(caddy_http_request_duration_seconds_count[15m]))",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "5xx Ratio By Host",
      "type": "timeseries",
      "description": "Share of each site's responses that were server errors, mostly 502s when the upstream service is down or restarting."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
